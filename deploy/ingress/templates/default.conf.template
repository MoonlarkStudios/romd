# Built-in ingress: one HTTPS listener per surface on a single host name.
# Credentials can occur in both URL paths and queries. Log only generated or
# classified values; never request lines, URIs, headers or upstream addresses.
map $server_port $romd_log_surface {
    default unknown;
    7663 consumer;
    7664 admin;
    7665 player;
}
log_format romd_ingress escape=json
    '{"event":"ingress_request","surface":"$romd_log_surface",'
    '"request_id":"$request_id","status":$status,"bytes":$body_bytes_sent,'
    '"duration":$request_time,"upstream_status":"$upstream_status",'
    '"upstream_connect_time":"$upstream_connect_time",'
    '"upstream_response_time":"$upstream_response_time"}';
map $http_upgrade $romd_connection_upgrade {
    default upgrade;
    '' close;
}
map $server_port $romd_upstream {
    default "";
    7663 http://romd-consumer:8080;
    7664 http://romd-admin:8080;
    7665 http://romd-player:8080;
}
# The listeners are fixed; the ports devices use are whatever the host publishes.
# The applications must see the published port to match their public origins.
map $server_port $romd_public_port {
    7663 ${ROMD_CONSUMER_PORT};
    7664 ${ROMD_ADMIN_PORT};
    7665 ${ROMD_PLAYER_PORT};
}
server {
    access_log /dev/stdout romd_ingress;
    # nginx's request error renderer includes the raw request and upstream URI.
    # Safe access events retain 4xx/5xx and timing diagnostics; startup errors
    # still use the image's global stderr logger before a request exists.
    error_log /dev/null;
    listen 7663 ssl default_server;
    listen 7664 ssl default_server;
    listen 7665 ssl default_server;
    ssl_certificate /etc/romd/tls/fullchain.pem;
    ssl_certificate_key /etc/romd/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_name ${ROMD_HOST};
    # A plain-HTTP request to an HTTPS listener: send the browser to the same place over HTTPS.
    error_page 497 =308 https://${ROMD_HOST}:$romd_public_port$request_uri;
    if ($host != "${ROMD_HOST}") { return 421; }
    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_http_version 1.1;
    # Authoritative values only: the validated name and the published port.
    proxy_set_header Host ${ROMD_HOST}:$romd_public_port;
    proxy_set_header X-Forwarded-Host ${ROMD_HOST}:$romd_public_port;
    # Replace caller-supplied chains. The application trusts this single proxy.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $romd_connection_upgrade;
    location /vfs/ {
        proxy_buffering off;
        proxy_pass $romd_upstream$request_uri;
    }
    location / { proxy_pass $romd_upstream$request_uri; }
}
