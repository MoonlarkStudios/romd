map $http_upgrade $romd_connection_upgrade {
    default upgrade;
    '' close;
}
map $host $romd_upstream {
    default "";
    ${ROMD_ADMIN_HOST} http://romd-admin:8080;
    ${ROMD_CONSUMER_HOST} http://romd-consumer:8080;
    ${ROMD_PLAYER_HOST} http://romd-player:8080;
}
server {
    listen 80 default_server;
    # No published port: this listener is only for the HTTPS tunnel.
    server_name ${ROMD_ADMIN_HOST} ${ROMD_CONSUMER_HOST} ${ROMD_PLAYER_HOST};
    if ($romd_upstream = "") { return 421; }
    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    # Replace caller-supplied chains. The application trusts this single proxy.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $romd_connection_upgrade;
    location / { proxy_pass $romd_upstream$request_uri; }
}
