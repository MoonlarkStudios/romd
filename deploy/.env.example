# Template for .env at the release root. Run scripts/deployment/setup.sh to
# create .env from it, or copy it to .env and fill it by hand, then chmod 600
# .env. ROMD generates its database passwords and signing secrets itself on
# first start and keeps them in Docker volumes, so none belong here. Never
# commit the completed file.

# Compose project and files, relative to the release root. Add the overlay for
# your ingress and, when ROMD_LIBRARY_PATH is set, deploy/examples/library/compose.yaml.
COMPOSE_PROJECT_NAME=romd
COMPOSE_FILE=compose.yaml

ROMD_DEFAULT_ADMIN_EMAIL=admin@example.com
ROMD_DEFAULT_ADMIN_PASSWORD=
ROMD_CONSUMER_DELIVERY_SIGNING_KEY_ID=primary

# Exact HTTPS origins, no paths or trailing slash. Consumer/player must differ.
ROMD_ADMIN_PUBLIC_URL=https://admin.example.com
ROMD_CONSUMER_PUBLIC_URL=https://console.example.com
ROMD_PLAYER_PUBLIC_URL=https://play.example.com
# Actual source IP of your final reverse proxy, as seen by the API containers.
ROMD_TRUSTED_PROXY=

# Optional read-only consumer VFS; disabled until explicitly enabled.
ROMD_VFS_ENABLED=false
ROMD_VFS_MAX_REQUESTS=8
ROMD_VFS_MAX_REQUESTS_PER_USER=4
ROMD_VFS_MAX_DIRECTORY_ENTRIES=20000

# Optional: an existing ROM library on this server, mounted read-only at
# /library on admin and worker for path import.
ROMD_LIBRARY_PATH=

# Configure IGDB and SteamGridDB in the admin portal under Integrations.
# OPTIONAL deployment override for IGDB: uncomment BOTH values only when you
# intentionally manage credentials outside the app. They take precedence over
# saved credentials and lock editing in the portal.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# SteamGridDB overrides need an explicit admin/worker environment overlay; see
# docs/configuration.md. Never set a blank API key there: it locks the portal.

# For the optional ingress examples only. Choose a non-conflicting subnet.
ROMD_EDGE_SUBNET=172.28.0.0/24
ROMD_EDGE_DYNAMIC_RANGE=172.28.0.128/25
ROMD_ADMIN_EDGE_IP=172.28.0.3
ROMD_CONSUMER_EDGE_IP=172.28.0.4
ROMD_PLAYER_EDGE_IP=172.28.0.5
# Cloudflare example only: pin the sole trusted connector outside the dynamic
# range, distinct from ingress and API/player addresses. Never use a CIDR here.
ROMD_CLOUDFLARED_EDGE_IP=172.28.0.6
# Set ROMD_TRUSTED_PROXY=172.28.0.2 when using the example subnet.
ROMD_ADMIN_HOST=admin.example.com
ROMD_CONSUMER_HOST=console.example.com
ROMD_PLAYER_HOST=play.example.com
# The examples ship reviewed nginx and cloudflared pins. To override them, set
# ROMD_NGINX_IMAGE or ROMD_CLOUDFLARED_IMAGE to an image pinned by digest.
CLOUDFLARE_TUNNEL_TOKEN=
# HTTPS example: absolute directory containing fullchain.pem and privkey.pem.
ROMD_TLS_DIRECTORY=
ROMD_HTTPS_BIND=127.0.0.1
ROMD_HTTPS_PORT=443
