# Copy to .env at the release root, set the three values below, and chmod 600 .env.
# ROMD generates its database passwords, signing secrets and HTTPS certificate
# itself on first start; none belong here. Never commit the completed file.

# The name or IP address devices on your network use to reach this server.
ROMD_HOST=

# The first administrator. The password only creates that account: after you
# sign in, change it in the admin portal and delete this line.
ROMD_DEFAULT_ADMIN_EMAIL=admin@example.com
ROMD_DEFAULT_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Everything below is optional.

# Published HTTPS ports (consumer portal, admin portal, player) and the address
# they bind to.
# ROMD_CONSUMER_PORT=7663
# ROMD_ADMIN_PORT=7664
# ROMD_PLAYER_PORT=7665
# ROMD_BIND=0.0.0.0

# Your own certificate in place of the generated one: an absolute directory
# containing fullchain.pem and privkey.pem valid for ROMD_HOST.
# ROMD_TLS_DIRECTORY=

# Compose project name and overlays, relative to the release root. Add
# deploy/examples/library/compose.yaml (with ROMD_LIBRARY_PATH) to import from an
# existing library on this server, or an ingress example to replace the built-in
# ingress.
# COMPOSE_PROJECT_NAME=romd
# COMPOSE_FILE=compose.yaml

# Optional read-only consumer VFS; disabled until explicitly enabled.
ROMD_VFS_ENABLED=false
ROMD_VFS_MAX_REQUESTS=8
ROMD_VFS_MAX_REQUESTS_PER_USER=4
ROMD_VFS_MAX_DIRECTORY_ENTRIES=20000

# Optional: an existing ROM library on this server, mounted read-only at
# /library on admin and worker for path import.
# ROMD_LIBRARY_PATH=

# Configure IGDB and SteamGridDB in the admin portal under Integrations.
# OPTIONAL deployment override for IGDB: uncomment BOTH values only when you
# intentionally manage credentials outside the app. They take precedence over
# saved credentials and lock editing in the portal.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# SteamGridDB overrides need an explicit admin/worker environment overlay; see
# docs/configuration.md. Never set a blank API key there: it locks the portal.

# Ingress examples (deploy/examples/https or deploy/examples/cloudflare) serve
# three host names in place of one name with three ports. They need each exact
# HTTPS origin, without a path or trailing slash, and its host name.
# ROMD_ADMIN_PUBLIC_URL=https://admin.example.com
# ROMD_CONSUMER_PUBLIC_URL=https://console.example.com
# ROMD_PLAYER_PUBLIC_URL=https://play.example.com
# ROMD_ADMIN_HOST=admin.example.com
# ROMD_CONSUMER_HOST=console.example.com
# ROMD_PLAYER_HOST=play.example.com
# HTTPS example: the certificate directory above, plus the listener.
# ROMD_HTTPS_BIND=127.0.0.1
# ROMD_HTTPS_PORT=443
# Cloudflare example: the tunnel token.
# CLOUDFLARE_TUNNEL_TOKEN=
# The ingress and connector images are reviewed pins. To override one, set
# ROMD_NGINX_IMAGE or ROMD_CLOUDFLARED_IMAGE to an image pinned by digest.
