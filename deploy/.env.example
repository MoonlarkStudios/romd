# Copy to .env at the deployment bundle root. Never commit the completed file.
# Use independent random hex values (e.g. openssl rand -hex 32) for secrets.
# Database passwords must be hex: they are embedded in connection strings.
ROMD_JWT_SECRET=
ROMD_DEFAULT_ADMIN_EMAIL=admin@example.com
ROMD_DEFAULT_ADMIN_PASSWORD=
ROMD_CONSUMER_DELIVERY_SIGNING_KEY_ID=primary
ROMD_CONSUMER_DELIVERY_SIGNING_SECRET=
ROMD_POSTGRES_BOOTSTRAP_PASSWORD=
ROMD_POSTGRES_PROVISIONER_PASSWORD=
ROMD_POSTGRES_WORKER_PASSWORD=
ROMD_POSTGRES_ADMIN_PASSWORD=
ROMD_POSTGRES_CONSUMER_PASSWORD=

# Exact HTTPS origins, no paths or trailing slash. Consumer/player must differ.
ROMD_ADMIN_PUBLIC_URL=https://admin.example.com
ROMD_CONSUMER_PUBLIC_URL=https://console.example.com
ROMD_PLAYER_PUBLIC_URL=https://play.example.com
# Actual source IP of your final reverse proxy, as seen by the API containers.
ROMD_TRUSTED_PROXY=

# Optional read-only consumer VFS; disabled until explicitly enabled.
ROMD_VFS_ENABLED=false
ROMD_VFS_MAX_REQUESTS=8
ROMD_VFS_MAX_REQUESTS_PER_USER=4
ROMD_VFS_MAX_DIRECTORY_ENTRIES=20000

# Optional IGDB override; leave empty to manage credentials in the Admin UI.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# For the optional ingress examples only. Choose a non-conflicting subnet.
ROMD_EDGE_SUBNET=172.28.0.0/24
ROMD_EDGE_DYNAMIC_RANGE=172.28.0.128/25
ROMD_ADMIN_EDGE_IP=172.28.0.3
ROMD_CONSUMER_EDGE_IP=172.28.0.4
ROMD_PLAYER_EDGE_IP=172.28.0.5
# Cloudflare example only: pin the sole trusted connector outside the dynamic
# range, distinct from ingress and API/player addresses. Never use a CIDR here.
ROMD_CLOUDFLARED_EDGE_IP=172.28.0.6
# Set ROMD_TRUSTED_PROXY=172.28.0.2 when using the example subnet.
ROMD_ADMIN_HOST=admin.example.com
ROMD_CONSUMER_HOST=console.example.com
ROMD_PLAYER_HOST=play.example.com
# Select reviewed release tags/digests for these optional third-party images.
ROMD_NGINX_IMAGE=
ROMD_CLOUDFLARED_IMAGE=
CLOUDFLARE_TUNNEL_TOKEN=
# HTTPS example: absolute directory containing fullchain.pem and privkey.pem.
ROMD_TLS_DIRECTORY=
ROMD_HTTPS_BIND=127.0.0.1
ROMD_HTTPS_PORT=443
