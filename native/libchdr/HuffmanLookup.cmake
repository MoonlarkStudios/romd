# Apply the reviewed repair to a build-tree copy; the pinned upstream checkout
# stays pristine. Fail closed when an upstream update changes the repaired file.
function(moonlark_patch_huffman upstream output)
  set(source "${upstream}/src/libchdr_huffman.c")
  file(SHA256 "${source}" digest)
  if(NOT digest STREQUAL "1d9617d27ec324674157dbe3e8284ed7ea32d6c6cf5b802996086559cef249f2")
    message(FATAL_ERROR "Review the Huffman lookup repair for this libchdr source")
  endif()
  file(READ "${source}" contents)
  set(before "\tconst lookup_value* lookupend = &decoder->lookup[(1u << decoder->maxbits)];\n\tuint32_t curcode;\n")
  set(after "${before}\t/* Incomplete trees use the same one-bit placeholder as the low-memory decoder. */\n\tfor (curcode = 0; curcode < (1u << decoder->maxbits); curcode++)\n\t\tdecoder->lookup[curcode] = MAKE_LOOKUP(0, 1);\n")
  string(FIND "${contents}" "${before}" position)
  if(position LESS 0)
    message(FATAL_ERROR "Missing full-table Huffman repair anchor")
  endif()
  string(REPLACE "${before}" "${after}" repaired "${contents}")
  get_filename_component(directory "${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  file(WRITE "${output}" "${repaired}")
endfunction()
