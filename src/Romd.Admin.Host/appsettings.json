{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Enrichment": {
    "GlobalSourcePriority": [
      "igdb"
    ],
    "MinimumAutoEnrichConfidence": 0.6,
    "DownloadMedia": true,
    "MediaTypesToDownload": [
      "Cover",
      "Screenshot",
      "Background"
    ],
    "MaxMediaDownloadConcurrency": 8,
    "PersistenceBatchSize": 25,
    "RegionPriority": [
      "USA",
      "WORLD",
      "EUROPE",
      "JAPAN"
    ],
    "Providers": {
      "igdb": {
        "Enabled": true,
        "RateLimit": 4
      }
    }
  },
  "Providers": {
    "Igdb": {
      "ClientId": "",
      "ClientSecret": ""
    }
  }
}
