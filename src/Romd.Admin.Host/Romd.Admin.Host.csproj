<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Romd.Admin.Host</RootNamespace>
    <AssemblyName>romd-admin</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <FrontendRoot>../../web</FrontendRoot>
    <FrontendDist>$(FrontendRoot)/packages/romd-admin-app/dist</FrontendDist>

    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Romd.Hosting\Romd.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <Target Name="BuildFrontend"
          BeforeTargets="Build"
          Condition="'$(BuildFrontend)' == 'true'">

    <Message Importance="high" Text="Installing frontend dependencies (Monorepo)..." />
    <Exec Command="pnpm install --frozen-lockfile" WorkingDirectory="$(FrontendRoot)" />

    <Message Importance="high" Text="Building frontend (Admin App)..." />
    <Exec Command="pnpm build" WorkingDirectory="$(FrontendRoot)" />
  </Target>

  <Target Name="CopyFrontend"
          AfterTargets="BuildFrontend"
          Condition="'$(BuildFrontend)' == 'true' AND Exists('$(FrontendDist)')">

    <ItemGroup>
      <FrontendFiles Include="$(FrontendDist)/**/*" />
    </ItemGroup>

    <Message Importance="high" Text="Copying frontend to wwwroot..." />

    <RemoveDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <Copy SourceFiles="@(FrontendFiles)"
          DestinationFiles="@(FrontendFiles->'wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="WarnMissingFrontend"
          BeforeTargets="Build"
          Condition="'$(BuildFrontend)' != 'true' AND '$(SkipMissingFrontendWarning)' != 'true' AND !Exists('wwwroot/index.html') AND '$(Configuration)' == 'Release'">
    <Warning Text="wwwroot is empty. Run 'dotnet build -p:BuildFrontend=true' to include frontend." />
  </Target>

  <Target Name="CopyOpenApiSchema"
          AfterTargets="Build"
          Condition="'$(OpenApiGenerateDocuments)' == 'true' AND Exists('$(OpenApiDocumentsDirectory)/$(MSBuildProjectName)_admin-v1.json')">
    <MakeDir Directories="$(FrontendRoot)/schemas" />
    <Copy SourceFiles="$(OpenApiDocumentsDirectory)/$(MSBuildProjectName)_admin-v1.json"
          DestinationFiles="$(FrontendRoot)/schemas/admin-v1.json"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Admin OpenAPI schema copied to $(FrontendRoot)/schemas/admin-v1.json" />
  </Target>

</Project>
