## Development defaults only. Production: deploy/.env.example and docs/production-deployment.md.

ROMD_JWT_SECRET=local-only-replace-this-jwt-secret-32-plus-chars
ROMD_DEFAULT_ADMIN_EMAIL=admin@example.test
ROMD_DEFAULT_ADMIN_PASSWORD=LocalOnly123

ROMD_CONSUMER_DELIVERY_SIGNING_KEY_ID=local-dev
ROMD_CONSUMER_DELIVERY_SIGNING_SECRET=local-only-replace-this-delivery-secret-32-bytes-min
ROMD_CONSUMER_DELIVERY_SIGNED_URL_TTL_MINUTES=10

# PostgreSQL production-topology credentials. These placeholders are local smoke
# values only; use independent generated secrets for every deployed role.
ROMD_POSTGRES_BOOTSTRAP_PASSWORD=local-only-bootstrap-password
ROMD_POSTGRES_PROVISIONER_PASSWORD=local-only-provisioner-password
ROMD_POSTGRES_WORKER_PASSWORD=local-only-worker-password
ROMD_POSTGRES_ADMIN_PASSWORD=local-only-admin-database-password
ROMD_POSTGRES_CONSUMER_PASSWORD=local-only-consumer-database-password

ROMD_ADMIN_PORT=5000
ROMD_CONSUMER_PORT=5002
ROMD_PLAYER_PORT=5175
ROMD_CONSUMER_URL=http://localhost:5002
ROMD_PLAYER_URL=http://localhost:5175
ROMD_PLAYER_ALLOWED_PARENTS=http://localhost:5002
ROMD_PLAYER_EMULATORJS_SOURCE=cdn
ROMD_PLAYER_EMULATORJS_DATA_PATH=
ROMD_PLAYER_CORES=

# Local dev database server host port (compose.db.yaml, mise db:* tasks)
ROMD_DB_PORT=15432

ROMD_DEV_ADMIN_PORT=11337
ROMD_DEV_CONSUMER_PORT=11338
ROMD_DEV_PLAYER_PORT=5175
ROMD_DEV_PLAYER_URL=http://localhost:5175
ROMD_DEV_PLAYER_ALLOWED_PARENTS=http://localhost:5174

# Optional deployment override for admin + worker. Leave both empty to configure
# IGDB in Admin Settings > Metadata Providers. Either value locks UI editing.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
