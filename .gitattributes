# Auto detect text files and perform LF normalization
* text=auto

# C# files
*.cs text diff=csharp

# Project files
*.csproj text
*.sln text eol=crlf
*.props text
*.targets text

# Config
*.json text
*.yml text
*.yaml text
*.xml text

# Documentation
*.md text diff=markdown
*.txt text

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.gz binary
