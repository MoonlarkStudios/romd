# Auto detect text files and perform LF normalization
* text=auto

# C# files
*.cs text diff=csharp

# Project files
*.csproj text
*.sln text eol=crlf
*.props text
*.targets text

# Config
*.json text
*.yml text
*.yaml text
*.xml text

# Documentation
*.md text diff=markdown
*.txt text

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.gz binary

# pnpm patch hashes and upstream line endings must survive checkout unchanged.
web/patches/*.patch -text

# Copied product kits retain upstream bytes, including font notice line endings.
brand/romd/** -text
brand/ottercade/** -text
# OFL notices contain intentional upstream trailing spaces; preserve them verbatim.
brand/romd/**/*.txt whitespace=-blank-at-eol
brand/ottercade/**/*.txt whitespace=-blank-at-eol
